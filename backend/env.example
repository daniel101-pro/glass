# Environment Configuration Example
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=4000

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/glass?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-32-chars-long
JWT_EXPIRES_IN=24h

# Security
BCRYPT_ROUNDS=10

# CORS (Optional - leave empty for development)
CORS_ORIGIN=https://your-frontend-domain.com

# Email Configuration (Gmail)
GMAIL_USER=try.glass101@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here

# Google Analytics Configuration (Optional)
# Get these from Google Cloud Console after setting up Analytics Data API
# Stream ID from GA4 Data Streams (e.g., 12952536444)
GA_PROPERTY_ID=12952536444
GA_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

